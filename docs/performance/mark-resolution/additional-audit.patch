+
+#[gpui_kit::test]
+#[ignore = "manual additional complexity audit on synthetic state/windows"]
+fn additional_render_complexity_audit(cx: &mut TestAppContext) {
+    use crate::marks::work;
+    use disktree_core::removal::Target;
+    use disktree_core::tree::{Node, NodeKind};
+
+    cx.update(gpui_omarchy::init);
+    let temp = tempfile::tempdir().expect("tempdir");
+    let scan_root = temp.path().join("scan");
+    std::fs::create_dir(&scan_root).expect("mkdir");
+    for count in [128, 1024] {
+        let root_path = scan_root.clone();
+        let mut tree = Node::directory("root");
+        let mut parent = Node::directory("container");
+        for index in 0..count {
+            parent.children.push(Node::entry(
+                format!("file-{index}"),
+                NodeKind::File,
+                1,
+            ));
+        }
+        tree.children.push(parent);
+        let (view, window) = cx.add_window_view(move |_, cx| {
+            Disktree::with_tree(root_path.clone(), tree, options(), 3, cx)
+        });
+        update(&view, window, |app, cx| {
+            work::reset();
+            let start = std::time::Instant::now();
+            for index in 0..count {
+                app.toggle_mark(&[0, index], cx);
+            }
+            assert_eq!(app.marks.len(), count);
+            eprintln!(
+                "audit bulk-mark M={count} ancestor-visits={} inside-visits={} wall={:?}",
+                work::AUDIT_ANCESTORS.get(),
+                work::AUDIT_INSIDE.get(),
+                start.elapsed()
+            );
+            work::reset();
+            let start = std::time::Instant::now();
+            app.toggle_mark(&[0], cx);
+            assert_eq!(app.marks.len(), 1);
+            assert!(app.marks.contains(&scan_root.join("container")));
+            eprintln!(
+                "audit absorb-parent M={count} retain-visits={} wall={:?}",
+                work::AUDIT_RETAIN.get(),
+                start.elapsed()
+            );
+            app.marks.clear();
+            for index in 0..count {
+                app.marks.toggle(Target {
+                    path: temp.path().join(format!("outside-{index}")),
+                    bytes: 1,
+                    is_dir: false,
+                    hidden: false,
+                });
+            }
+            app.screen = Screen::Review;
+        });
+        work::reset();
+        let start = std::time::Instant::now();
+        for _ in 0..4 {
+            update(&view, window, |_, cx| cx.notify());
+            draw(window);
+        }
+        let frames = work::RENDERS.get();
+        assert!(frames >= 4);
+        eprintln!(
+            "audit blocked-review M={count} row-checks={} renders={frames} per-render={} wall={:?}",
+            work::AUDIT_ROWS.get(),
+            work::AUDIT_ROWS.get() / frames,
+            start.elapsed()
+        );
+        update(&view, window, |app, cx| {
+            // Manual marking absorbs these; raw/programmatic queues can
+            // still present overlapping targets to the review renderer.
+            app.marks.clear();
+            let parent = app.target_at(&[0]).expect("parent");
+            app.marks.toggle(parent);
+            for index in 0..count {
+                let child = app.target_at(&[0, index]).expect("child");
+                app.marks.toggle(child);
+            }
+            cx.notify();
+        });
+        work::reset();
+        let start = std::time::Instant::now();
+        for _ in 0..4 {
+            update(&view, window, |_, cx| cx.notify());
+            draw(window);
+        }
+        let frames = work::RENDERS.get();
+        assert!(frames >= 4);
+        eprintln!(
+            "audit covered-review children={count} row-checks={} renders={frames} per-render={} wall={:?}",
+            work::AUDIT_ROWS.get(),
+            work::AUDIT_ROWS.get() / frames,
+            start.elapsed()
+        );
+        window.update(|window, _| window.remove_window());
+    }
+    for depth in [128, 1024] {
+        let root_path = scan_root.clone();
+        let mut tree = Node::directory("x");
+        tree.children
+            .push(Node::entry("payload", NodeKind::File, 1));
+        for _ in 0..depth {
+            let mut parent = Node::directory("x");
+            parent.children.push(tree);
+            tree = parent;
+        }
+        let (view, window) = cx.add_window_view(move |_, cx| {
+            Disktree::with_tree(root_path.clone(), tree, options(), 3, cx)
+        });
+        update(&view, window, |app, cx| {
+            app.crumbs = vec![0; depth];
+            app.selected = None;
+            cx.notify();
+        });
+        work::reset();
+        let start = std::time::Instant::now();
+        for _ in 0..4 {
+            update(&view, window, |_, cx| cx.notify());
+            draw(window);
+        }
+        let frames = work::RENDERS.get();
+        assert!(frames >= 4);
+        eprintln!(
+            "audit deep-breadcrumbs D={depth} prefix-walks={} renders={frames} per-render={} wall={:?}",
+            work::AUDIT_CRUMBS.get(),
+            work::AUDIT_CRUMBS.get() / frames,
+            start.elapsed()
+        );
+        window.update(|window, _| window.remove_window());
+    }
+}
